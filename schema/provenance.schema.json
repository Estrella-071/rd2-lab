{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rd2-lab.example/schema/provenance.schema.json",
  "title": "Random Dice 2 Lab published data provenance",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "verifiedAt", "publishedData", "limitations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "snapshotId": { "type": "string" },
    "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "publishedData": {
      "type": "object",
      "required": ["json", "svg", "compendium", "metadata", "changelog", "officialNotices", "monsterPosters", "nodeCount", "edgeCount", "gameDataVersion"],
      "properties": {
        "json": { "$ref": "#/$defs/file" },
        "svg": { "$ref": "#/$defs/file" },
        "compendium": { "$ref": "#/$defs/file" },
        "metadata": { "$ref": "#/$defs/file" },
        "changelog": { "$ref": "#/$defs/file" },
        "officialNotices": { "$ref": "#/$defs/file" },
        "monsterPosters": { "$ref": "#/$defs/file" },
        "nodeCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "gameDataVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(site/)?[A-Za-z0-9_./-]+$" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
