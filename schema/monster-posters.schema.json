{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rd2-lab.example/schema/monster-posters.schema.json",
  "title": "Random Dice 2 Lab static monster posters",
  "type": "object",
  "required": ["schemaVersion", "snapshot", "monsters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "metadata_ref", "verified_at"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "metadata_ref": { "const": "data/game_data_metadata.json" },
        "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "additionalProperties": false
    },
    "monsters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["poster"],
        "properties": {
          "poster": { "type": "string", "pattern": "^icons/[A-Za-z0-9_.-]+\\.png$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
