{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rd2-lab.example/schema/monster-visuals.schema.json",
  "title": "Random Dice 2 Lab monster visuals",
  "type": "object",
  "required": ["schemaVersion", "snapshot", "monsters"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "snapshot": {
      "type": "object",
      "required": ["snapshot_id", "metadata_ref", "verified_at", "spine_version"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "metadata_ref": { "const": "data/game_data_metadata.json" },
        "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "spine_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "monsters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["poster", "spine"],
        "properties": {
          "poster": { "type": "string", "pattern": "^icons/[A-Za-z0-9_.-]+\\.png$" },
          "spine": {
            "type": "object",
            "required": ["skeleton", "atlas", "texture", "animation"],
            "properties": {
              "skeleton": { "type": "string" },
              "atlas": { "type": "string" },
              "texture": { "type": "string" },
              "animation": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "variants": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
